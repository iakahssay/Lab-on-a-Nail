<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- This makes the inside transparent -->
    <solid android:color="@android:color/transparent" />

    <!-- This creates the black outline -->
    <!-- You can adjust the width (2dp) to make the line thicker or thinner -->
    <stroke
        android:width="2dp"
        android:color="#FF000000" />

    <!-- Note: corners radius is not needed for 'oval' as it's automatically circular -->

</shape>