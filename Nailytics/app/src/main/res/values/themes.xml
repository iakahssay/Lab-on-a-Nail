<?xml version="1.0" encoding="utf-8"?>
<resources>
<style name="Theme.Nailytics" parent="Theme.MaterialComponents.DayNight.NoActionBar">

    <item name="colorAccent">@color/accent</item>

    !-- Main app brand color -->
    <item name="colorPrimary">@color/primary</item>

    <!-- Lighter version of primary color used by Material components -->
    <item name="colorPrimaryVariant">@color/primary_light</item>

    <!-- Secondary accent color used by Material components -->
    <item name="colorSecondary">@color/secondary</item>

    <!-- Main background color for windows/screens -->
    <item name="android:windowBackground">@color/background_main</item>

    <!-- Status bar color at the top of the phone -->
    <item name="android:statusBarColor">@color/background_main</item>

    <!-- Navigation bar color at the bottom of the phone -->
    <item name="android:navigationBarColor">@color/nav_background</item>

    <!-- Makes status bar icons dark instead of white -->
    <item name="android:windowLightStatusBar">true</item>

</style>

<style name="WindowAnimation">
    <!-- Animation for the new Activity entering when moving forward -->
    <item name="android:activityOpenEnterAnimation">@anim/slide_fade_in</item>

    <!-- Animation for the old Activity leaving when moving forward -->
    <item name="android:activityOpenExitAnimation">@anim/fade_out</item>

    <!-- Animation for the previous Activity re-entering when going back -->
    <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>

    <!-- Animation for the current Activity leaving when going back -->
    <item name="android:activityCloseExitAnimation">@anim/slide_fade_out</item>
</style>

</resources>