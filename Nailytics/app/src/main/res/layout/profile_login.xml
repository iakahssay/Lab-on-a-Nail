<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">


    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="410dp"
        android:layout_height="88dp"
        android:orientation="vertical"
        android:layout_marginBottom="75dp"
        app:layout_constraintBottom_toTopOf="@+id/sign_in_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <LinearLayout
            android:id="@+id/chrome"
            android:layout_width="410dp"
            android:layout_height="88dp"
            android:background="#BFFFFFFF"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_and_controls"
                android:layout_width="410dp"
                android:layout_height="44dp"
                android:layout_marginTop="45dp">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="69dp"
                    android:layout_height="22dp"
                    android:gravity="center_horizontal"
                    android:text="Sign In"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/materials"
            android:layout_width="410dp"
            android:layout_height="88dp">

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sign_in_logo"
        android:layout_width="220dp"
        android:layout_height="260dp"
        android:gravity="center"
        android:layout_marginTop="90dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@+id/user_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:gravity="center"
            android:src="@mipmap/hero_image_foreground" />

        <TextView
            android:id="@+id/nailytics"
            android:layout_width="216dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="Nailytics"
            android:textColor="@color/text_primary"
            android:textSize="34sp"
            android:textStyle="bold" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/user_input"
        android:layout_width="346dp"
        android:layout_height="324dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.675">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/email_or_username_section"
            android:layout_width="332dp"
            android:layout_height="76dp">

            <TextView
                android:id="@+id/username_or_email"
                android:layout_width="187dp"
                android:layout_height="32dp"
                android:gravity="start"
                android:text="Email or Username:"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/username_input"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/username_input"
                android:layout_width="332dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_rounded_gray80_corner_12_frame"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:paddingLeft="17.4dp"
                android:paddingTop="10dp"
                android:paddingRight="17.4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/background_username_prompt"
                    android:layout_width="297dp"
                    android:layout_height="25dp"
                    android:gravity="center_vertical"
                    android:text="Enter Email or Username"
                    android:textColor="@color/black_overlay_25"
                    android:textSize="20sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/password_section"
            android:layout_width="332dp"
            android:layout_height="116dp">

            <TextView
                android:id="@+id/password"
                android:layout_width="137dp"
                android:layout_height="32dp"
                android:layout_marginTop="26dp"
                android:gravity="start"
                android:text="Password:"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                app:layout_constraintBottom_toTopOf="@+id/password_input"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/password_input"
                android:layout_width="332dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_rounded_gray80_corner_12_frame"
                android:layout_marginTop="40dp"
                android:orientation="horizontal"
                android:paddingLeft="17.4dp"
                android:paddingTop="10dp"
                android:paddingRight="17.4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/background_password_prompt"
                    android:layout_width="297dp"
                    android:layout_height="25dp"
                    android:gravity="center_vertical"
                    android:text="Enter Password"
                    android:textColor="@color/black_overlay_25"
                    android:textSize="20sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:id="@+id/button"
            android:layout_width="344dp"
            android:layout_height="50dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_rounded_button"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingTop="14dp"
            android:paddingRight="20dp"
            android:paddingBottom="14dp"
            app:layout_constraintTop_toBottomOf="@+id/password_input">


            <TextView
                android:id="@+id/label"
                android:layout_width="304dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="Continue"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="340dp"
            android:layout_height="33dp"
            android:orientation="horizontal"
            android:layout_marginTop="26dp">

            <TextView
                    android:id="@+id/not_a_member"
                    android:layout_width="140dp"
                    android:layout_height="33dp"
                    android:gravity="start"
                    android:text="@string/not_a_member"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/register_now"
                    android:layout_width="140dp"
                    android:layout_height="33dp"
                    android:gravity="start"
                    android:paddingStart="8dp"
                    android:text="@string/register_now"
                    android:textColor="@color/slate_purple"
                    android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>