<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">

    

    
    <androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/material" android:layout_width="250dp" android:layout_height="176dp">

        
        <LinearLayout android:id="@+id/regular" android:layout_width="250dp" android:layout_height="176dp" android:background="#D1B3B3B3" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    
    <LinearLayout android:id="@+id/item_1" android:orientation="horizontal" android:layout_width="250dp" android:layout_height="44dp" android:paddingLeft="16dp" android:paddingTop="0dp" android:paddingRight="16dp" android:paddingBottom="0dp">

        
        <TextView android:id="@+id/label" android:text="pH 5.0" android:textSize="17sp" android:textColor="#FF000000" android:gravity="start" android:layout_width="198dp" android:layout_height="22dp" />

        
        <TextView android:id="@+id/symbol" android:text="􀆅" android:textSize="17sp" android:textColor="#FF000000" android:gravity="center" android:layout_width="20dp" android:layout_height="43dp" />
    </LinearLayout>

    
    <LinearLayout android:id="@+id/item_2" android:orientation="horizontal" android:layout_width="250dp" android:layout_height="44dp" android:paddingLeft="16dp" android:paddingTop="0dp" android:paddingRight="16dp" android:paddingBottom="0dp">

        
        <TextView android:id="@+id/label_2" android:text="pH 6.0" android:textSize="17sp" android:textColor="#FF000000" android:gravity="start" android:layout_width="218dp" android:layout_height="22dp" />
    </LinearLayout>

    
    <LinearLayout android:id="@+id/item_3" android:orientation="horizontal" android:layout_width="250dp" android:layout_height="44dp" android:paddingLeft="16dp" android:paddingTop="0dp" android:paddingRight="16dp" android:paddingBottom="0dp">

        
        <TextView android:id="@+id/label_3" android:text="pH 7.0" android:textSize="17sp" android:textColor="#FF000000" android:gravity="start" android:layout_width="218dp" android:layout_height="22dp" />
    </LinearLayout>

    
    <LinearLayout android:id="@+id/item_4" android:orientation="horizontal" android:layout_width="250dp" android:layout_height="44dp" android:paddingLeft="16dp" android:paddingTop="0dp" android:paddingRight="16dp" android:paddingBottom="0dp">

        
        <TextView android:id="@+id/label_4" android:text="pH 8.0" android:textSize="17sp" android:textColor="#FF000000" android:gravity="start" android:layout_width="218dp" android:layout_height="22dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
