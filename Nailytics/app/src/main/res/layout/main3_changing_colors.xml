<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_main">


    <LinearLayout
        android:id="@+id/navigation_bar_iphone_compact_size_class"
        android:layout_width="410dp"
        android:layout_height="88dp"
        android:orientation="vertical"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toTopOf="@+id/body"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/materials"
            android:layout_width="410dp"
            android:layout_height="88dp">


            <LinearLayout
                android:id="@+id/chrome"
                android:layout_width="410dp"
                android:layout_height="88dp"
                android:background="#BFFFFFFF"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/title_and_controls"
                    android:layout_width="410dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="45dp">


                    <LinearLayout
                        android:id="@+id/back_button"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:orientation="horizontal"
                        android:paddingTop="11dp"
                        android:paddingBottom="11dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/title"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintVertical_bias="0.0">

                        <ImageView
                            android:id="@+id/chevron"
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="14dp"
                            android:gravity="start"
                            android:rotation="0"
                            android:src="@drawable/ic_chevron"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"></ImageView>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="69dp"
                        android:layout_height="22dp"
                        android:gravity="center_horizontal"
                        android:text="Nailytics"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/body"
        android:layout_width="398dp"
        android:layout_height="730dp"
        android:layout_marginTop="94dp"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/analyte_section"
            android:layout_width="398dp"
            android:layout_height="180dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <LinearLayout
                android:id="@+id/dropDownSection"
                android:layout_width="398dp"
                android:layout_height="32dp"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_rounded_white_corner_16_frame"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:clickable="true"
                android:focusable="true">


                <TextView
                    android:id="@+id/analyte_type"
                    android:layout_width="325dp"
                    android:layout_height="22dp"
                    android:gravity="start"
                    android:text="@string/ph_levels_saliva"
                    android:textColor="#FF131036"
                    android:textSize="17sp" />


                <LinearLayout
                    android:id="@+id/dropDownArrow"
                    android:layout_width="41dp"
                    android:layout_height="32dp"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:layout_marginTop="6dp">

                    <ImageView
                        android:id="@+id/chevron2"
                        android:layout_width="17dp"
                        android:layout_height="20dp"
                        android:gravity="start"
                        android:rotation="270"
                        android:src="@drawable/ic_chevron">
                    </ImageView>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/color_chart"
                android:layout_width="377dp"
                android:layout_height="130dp"
                android:layout_marginStart="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/item0"
                    android:layout_width="88dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/item0_color"
                        android:layout_width="88dp"
                        android:layout_height="82dp"
                        android:background="@color/deep_rose_light"
                        android:orientation="vertical"

                        />

                    <TextView
                        android:id="@+id/item0_label"
                        android:layout_width="74dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/ph5"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/item1"
                    android:layout_width="88dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/item1_color"
                        android:layout_width="88dp"
                        android:layout_height="82dp"
                        android:background="#D1811537"
                        android:orientation="vertical" />


                    <TextView
                        android:id="@+id/item1_label"
                        android:layout_width="74dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/ph6"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/item2"
                    android:layout_width="88dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">


                    <ImageView
                        android:id="@+id/item2_color"
                        android:layout_width="88dp"
                        android:layout_height="82dp"
                        android:background="#D1621340"
                        android:orientation="vertical" />


                    <TextView
                        android:id="@+id/item2_label"
                        android:layout_width="74dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/ph7"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/item3"
                    android:layout_width="88dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/item3_color"
                        android:layout_width="88dp"
                        android:layout_height="82dp"
                        android:background="#DB366877"
                        android:orientation="vertical" />


                    <TextView
                        android:id="@+id/item3_label"
                        android:layout_width="74dp"
                        android:layout_height="45dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="@string/ph8"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/edit_color_modal"
        android:layout_width="398dp"
        android:layout_height="540dp"
        android:layout_marginTop="172dp"
        android:background="@drawable/bg_rounded_gray90_corner_12_frame"
        android:orientation="vertical"
        android:paddingLeft="31dp"
        android:paddingRight="31dp"
        app:layout_constraintBottom_toTopOf="@+id/tab_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/body">


        <LinearLayout
            android:id="@+id/instructions"
            android:layout_width="365dp"
            android:layout_height="128dp"
            android:orientation="vertical">


            <TextView
                android:id="@+id/update_target_color"
                android:layout_width="365dp"
                android:layout_height="22dp"
                android:gravity="start"
                android:text="Update Target Color"
                android:textColor="#FF000000"
                android:textSize="17sp"
                android:layout_marginBottom="10dp"
                />

            <LinearLayout
                android:id="@+id/update_target_info_body"
                android:layout_width="364dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_rounded_gray90_corner_12_frame"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp"
                >


                <ImageView
                    android:id="@+id/info_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginTop="3dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_info" />


                <TextView
                    android:id="@+id/choose_a_color_using_the_interactive_picker__copy_the_hex_or_rgb_value_and_enter_it_below_"
                    android:layout_width="330dp"
                    android:layout_height="44dp"
                    android:gravity="start"
                    android:text="@string/choose_a_color_using_the_interactive_picker"
                    android:textColor="#FF000000"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/analyte_value_dropDown"
                android:layout_width="336dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_rounded_white_corner_16_frame"
                android:orientation="horizontal"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                >


                <TextView
                    android:id="@+id/analyte_value"
                    android:layout_width="263dp"
                    android:layout_height="22dp"
                    android:gravity="start"
                    android:text="pH 5.0"
                    android:textColor="#FF131036"
                    android:textSize="17sp"
                    android:layout_marginTop="4dp"
                    />


                <LinearLayout
                    android:id="@+id/analyte_value_dropDownArrow"
                    android:layout_width="41dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingBottom="0dp">

                    <ImageView
                        android:id="@+id/analyte_value_dropDownArrow_label"
                        android:layout_width="17dp"
                        android:layout_height="20dp"
                        android:gravity="start"
                        android:rotation="270"
                        android:src="@drawable/ic_chevron">
                    </ImageView>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/color_picker"
            android:layout_width="334dp"
            android:layout_height="357dp"
            android:background="@drawable/bg_rounded_color_picker"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            >


            <LinearLayout
                android:id="@+id/color_wheel"
                android:layout_width="231dp"
                android:layout_height="231dp"
                android:layout_marginStart="50dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/main_change_color_gradient_color_modal_frame"
                android:orientation="vertical"
                >

                <ImageView
                    android:id="@+id/pointer_3_3"
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:scaleType="fitXY"
                    android:layout_marginTop="50dp"
                    android:layout_marginLeft="210dp"
                    android:src="@drawable/bg_rounded_transparent_circle" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/preview_and_slides"
                android:layout_width="228dp"
                android:layout_height="37dp"
                android:orientation="horizontal"
                android:layout_marginLeft="50dp"
                >


                <LinearLayout
                    android:id="@+id/preview"
                    android:layout_width="37dp"
                    android:layout_height="37dp"
                    android:background="@drawable/bg_rounded_preview"
                    android:orientation="horizontal"
                    android:padding= "6dp"
                    android:layout_marginRight="10dp"
                    >

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_color_picker">
                    </ImageView>

                </LinearLayout>


                <LinearLayout
                    android:id="@+id/sliders"
                    android:layout_width="183dp"
                    android:layout_height="37dp"
                    android:orientation="vertical">


                    <LinearLayout
                        android:id="@+id/color_slider"
                        android:layout_width="183dp"
                        android:layout_height="13dp"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp"
                        android:background="@drawable/bg_rounded_color_picker"
                        >


                        <LinearLayout
                            android:id="@+id/rectangle_2"
                            android:layout_width="183dp"
                            android:layout_height="13dp"
                            android:background="@drawable/main_change_color_gradient_raindbow_bg_bttn"
                            android:orientation="vertical"
                            >

                            <ImageView
                                android:id="@+id/pointer_3"
                                android:layout_width="12.8dp"
                                android:layout_height="12.8dp"
                                android:scaleType="fitXY"
                                android:layout_marginLeft="5dp"
                                android:src="@drawable/bg_rounded_transparent_circle" />
                        </LinearLayout>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/transparency_slider"
                        android:layout_width="183dp"
                        android:layout_height="13dp"
                        android:orientation="horizontal">


                        <LinearLayout
                            android:id="@+id/rectangle_2_2_4"
                            android:layout_width="183dp"
                            android:layout_height="13dp"
                            android:background="@drawable/main_change_color_gradient_fade_out_bg_bttn"
                            android:orientation="vertical" >

                            <ImageView
                                android:id="@+id/pointer_3_2"
                                android:layout_width="13dp"
                                android:layout_height="13dp"
                                android:scaleType="fitXY"
                                android:layout_marginLeft="165dp"
                                android:src="@drawable/bg_rounded_transparent_circle" />
                        </LinearLayout>


                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/color_value_inputs"
                android:layout_width="280dp"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:layout_marginTop="14dp"
                android:layout_marginStart="20dp"
                >


                <LinearLayout
                    android:id="@+id/hex_color_section"
                    android:layout_width="90dp"
                    android:layout_height="62dp"
                    android:orientation="vertical">


                    <TextView
                        android:id="@+id/hex_color_label"
                        android:layout_width="match_parent"
                        android:layout_height="19dp"
                        android:gravity="center_horizontal"
                        android:text="HEX"
                        android:textColor="#FF000000"
                        android:textSize="16sp"
                        android:layout_marginBottom="6dp"
                        />


                    <LinearLayout
                        android:id="@+id/hex_color_input_box"
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:gravity="center">

                            <EditText
                                android:id="@+id/hex_color_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="38dp"
                                android:gravity="center"
                                android:inputType="textCapCharacters"
                                android:autofillHints="hexadecimal"
                                android:maxLength="9"
                                android:text="#9B123A"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />

                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/rgb_section"
                    android:layout_width="194dp"
                    android:layout_height="62dp"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:id="@+id/r_section"
                        android:layout_width="65dp"
                        android:layout_height="62dp"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/r_label"
                            android:layout_width="match_parent"
                            android:layout_height="19dp"
                            android:gravity="center_horizontal"
                            android:text="R"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"
                            />


                        <LinearLayout
                            android:id="@+id/r_input_box"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:gravity="center">

                            <EditText
                                android:id="@+id/r_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="38dp"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="155"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/g_section"
                        android:layout_width="65dp"
                        android:layout_height="62dp"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/g_label"
                            android:layout_width="match_parent"
                            android:layout_height="19dp"
                            android:gravity="center_horizontal"
                            android:text="G"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"
                            />


                        <LinearLayout
                            android:id="@+id/g_input_box"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:gravity="center">

                            <EditText
                                android:id="@+id/g_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="38dp"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="18"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/b_section"
                        android:layout_width="65dp"
                        android:layout_height="62dp"
                        android:orientation="vertical">


                        <TextView
                            android:id="@+id/b_label"
                            android:layout_width="match_parent"
                            android:layout_height="19dp"
                            android:gravity="center_horizontal"
                            android:text="B"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:layout_marginBottom="6dp"
                            />


                        <LinearLayout
                            android:id="@+id/b_input_box"
                            android:layout_width="match_parent"
                            android:layout_height="38dp"
                            android:gravity="center">

                            <EditText
                                android:id="@+id/b_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="38dp"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="3"
                                android:text="58"
                                android:textColor="@color/text_primary"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/button_2s"
            android:layout_width="322dp"
            android:layout_height="25dp"
            android:layout_marginTop="8dp">


            <LinearLayout
                android:id="@+id/save_button"
                android:layout_width="53dp"
                android:layout_height="25dp"
                android:layout_marginStart="269dp"
                android:background="@drawable/bg_rounded_button"
                android:orientation="horizontal"
                android:paddingLeft="9dp"
                android:paddingTop="1dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/save_buttonlabel"
                    android:layout_width="36dp"
                    android:layout_height="18dp"
                    android:gravity="start"
                    android:text="Save"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/cancel_button"
                android:layout_width="68dp"
                android:layout_height="25dp"
                android:background="@drawable/bg_cancel_button"
                android:orientation="horizontal"
                android:paddingLeft="10dp"
                android:paddingTop="1dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <TextView
                    android:id="@+id/cancel_button_label"
                    android:layout_width="51dp"
                    android:layout_height="18dp"
                    android:gravity="start"
                    android:text="Cancel"
                    android:textColor="@color/accent_red"
                    android:textSize="16sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>


    <!-- TAB SECTION -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_bar"
        android:layout_width="410dp"
        android:layout_height="73dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chrome_material"
            android:layout_width="410dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent">


            <LinearLayout
                android:id="@+id/chrome_material2"
                android:layout_width="420dp"
                android:layout_height="match_parent"
                android:background="#BFFFFFFF"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <LinearLayout
            android:id="@+id/tab_bar_buttons"
            android:layout_width="410dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_tab"
                android:layout_width="143dp"
                android:layout_height="40dp">


                <TextView
                    android:id="@+id/home_label"
                    android:layout_width="146dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:text="Home"
                    android:textColor="@color/slate_purple"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/home_symbol"
                    android:layout_width="83dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_home_active"
                    app:layout_constraintBottom_toTopOf="@+id/home_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/summary_tab"
                android:layout_width="143dp"
                android:layout_height="40dp">


                <TextView
                    android:id="@+id/summary_label"
                    android:layout_width="146dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:text="Summary"
                    android:textColor="@color/gray_350"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/summary_symbol"
                    android:layout_width="90dp"
                    android:layout_height="21dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_summary"
                    app:layout_constraintBottom_toTopOf="@+id/summary_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_tab"
                android:layout_width="143dp"
                android:layout_height="40dp">


                <TextView
                    android:id="@+id/profile_label"
                    android:layout_width="146dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="-1dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:text="Profile"
                    android:textColor="@color/gray_350"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/profile_symbol"
                    android:layout_width="90dp"
                    android:layout_height="21dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_profile"
                    app:layout_constraintBottom_toTopOf="@+id/profile_label"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- DIMMING OVERLAY FOR CLICKABLE DROPDOWN MENU -->
    <View
        android:id="@+id/screen_dim_overlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#80000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>