<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main"
    tools:ignore="HardcodedText,SmallSp">

    <TextView
        android:id="@+id/main_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="16dp"
        android:gravity="start"
        android:text="Nailytics"
        android:textColor="@color/text_primary"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/main_description"
        />

    <TextView
        android:id="@+id/main_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:gravity="start"
        android:text="This app helps you monitor your health by analyzing the color of the fake nail’s biosensor."
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_title"
        app:layout_constraintBottom_toTopOf="@id/color_wheel_container"
        />

    <FrameLayout
        android:id="@+id/color_wheel_container"
        android:layout_width="300dp"
        android:layout_height="296dp"
        android:layout_marginTop="42dp"
        android:background="@drawable/hero_img_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_description"
        app:layout_constraintBottom_toTopOf="@id/start_prompt"
        >

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:src="@mipmap/hero_image_foreground"/>
    </FrameLayout>

    <TextView
        android:id="@+id/start_prompt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="40dp"
        android:layout_marginEnd="16dp"
        android:gravity="start"
        android:text="Ready to begin? Click the button below to start the health check now!"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/color_wheel_container"
        app:layout_constraintBottom_toTopOf="@id/start_button"
        />

    <TextView
        android:id="@+id/start_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="131dp"
        android:background="@drawable/bg_rounded_button"
        android:gravity="center"
        android:text="Start"
        android:textColor="@color/text_on_dark"
        android:textSize="17sp"
        app:layout_constraintBottom_toTopOf="@+id/tab_bar___iphone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/start_prompt" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tab_bar___iphone"
        android:layout_width="410dp"
        android:layout_height="83dp"
        android:layout_marginTop="849dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/chrome_material"
            android:layout_width="410dp"
            android:layout_height="83dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <LinearLayout
                android:id="@+id/chrome_2"
                android:layout_width="420dp"
                android:layout_height="63dp"
                android:background="#BFFFFFFF"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>


        <LinearLayout
            android:id="@+id/tab_bar_buttons"
            android:layout_width="410dp"
            android:layout_height="40dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="18dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/home_tab"
                android:layout_width="143dp"
                android:layout_height="40dp">


                <TextView
                    android:id="@+id/label_3"
                    android:layout_width="146dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:text="Home"
                    android:textColor="#FF5856D6"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/symbol"
                    android:layout_width="83dp"
                    android:layout_height="25dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_home_active"
                    app:layout_constraintBottom_toTopOf="@+id/label_3"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/summary_tab"
                android:layout_width="143dp"
                android:layout_height="40dp">


                <TextView
                    android:id="@+id/label_4"
                    android:layout_width="146dp"
                    android:layout_height="12dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:text="Summary"
                    android:textColor="#FF999999"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/ic_summary"
                    android:layout_width="90dp"
                    android:layout_height="21dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_summary"
                    app:layout_constraintBottom_toTopOf="@+id/label_4"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/profile_tab"
                android:layout_width="143dp"
                android:layout_height="40dp">


                <TextView
                    android:id="@+id/label_5"
                    android:layout_width="146dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="-1dp"
                    android:layout_marginTop="28dp"
                    android:gravity="center_horizontal"
                    android:text="Profile"
                    android:textColor="#FF999999"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <ImageView
                    android:id="@+id/symbol_3"
                    android:layout_width="90dp"
                    android:layout_height="21dp"
                    android:layout_marginTop="1dp"
                    android:gravity="center_horizontal"
                    android:src="@drawable/ic_profile"
                    app:layout_constraintBottom_toTopOf="@+id/label_5"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
