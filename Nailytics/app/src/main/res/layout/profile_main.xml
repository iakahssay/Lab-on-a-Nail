                <TextView
                    android:id="@+id/edit_users_name"
                    android:layout_width="162dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="7dp"
                    android:gravity="end"
                    android:text="@string/full_name"
                    android:textColor="@color/dark_gray_overlay_strong"
