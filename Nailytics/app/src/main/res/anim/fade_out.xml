<?xml version="1.0" encoding="utf-8"?>
<!-- Fade-out animation used when a screen disappears. -->
    <!-- android:duration -> Runs the animation for 500 ms to match Figma's timing. -->
    <!-- android:fromAlpha -> Starts fully visible. -->
    <!-- android:toAlpha -> Ends fully transparent. -->
    <!-- android:interpolator -> Uses gentle acceleration so the screen eases out softly. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="120"

    android:fromAlpha="1.0"

    android:toAlpha="0.0"

    android:interpolator="@android:interpolator/accelerate_quad"
/>