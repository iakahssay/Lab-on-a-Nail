<?xml version="1.0" encoding="utf-8"?>

<!-- Combines a small slide with a fade-in for a gentle Smart Animate-like entrance. -->
    <!-- android:duration -> Runs the full animation for 500 ms. -->
    <!-- android:interpolator -> Makes the movement slow down gently at the end. -->
    <!-- alpha -> Fades the incoming screen in. -->
        <!-- android:fromAlpha -> Starts fully transparent. -->
        <!-- android:toAlpha -> Ends fully visible. -->
    <!-- translate -> Slides the incoming screen slightly from the right. -->
        <!-- android:fromXDelta -> Starts just 4% to the right for a subtle, gentle transition. -->
        <!-- android:toXDelta -> Ends in its normal position. -->

<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="350"

    android:interpolator="@android:interpolator/decelerate_quad">

    <alpha
        android:fromAlpha="0.0"
        android:toAlpha="1.0" />

    <translate
        android:fromXDelta="2%"
        android:toXDelta="0%" />
</set>