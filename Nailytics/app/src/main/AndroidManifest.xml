<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ========================================================= -->
    <!-- NIX SENSOR BLUETOOTH PERMISSIONS -->
    <!-- ========================================================= -->

    <!-- Required on Android 12+ to scan for nearby Bluetooth devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />

    <!-- Required on Android 12+ to connect to Bluetooth devices. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Required on older Android versions for Bluetooth device discovery. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Older coarse location permission used by some Bluetooth scanning APIs. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ========================================================= -->

