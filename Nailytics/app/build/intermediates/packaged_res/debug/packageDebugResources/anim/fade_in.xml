<?xml version="1.0" encoding="utf-8"?>
<!-- Fade-in animation used when a screen appears. -->
    <!-- android:duration -> Runs the animation for 500 ms to match Figma's timing. -->
    <!-- android:fromAlpha -> Starts fully transparent. -->
    <!-- android:toAlpha -> Ends fully visible. -->
    <!-- android:interpolator -> Uses a gentle deceleration so the motion slows softly at the end. -->

<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="180"

    android:fromAlpha="0.0"

    android:toAlpha="1.0"

    android:interpolator="@android:interpolator/decelerate_quad"
    />
